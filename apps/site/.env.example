# Dev and preview server proxy target for /api/skills-sh.
# Use the local Worker (wrangler dev) or a catalog server with the
# /api/skills-sh aliases.
VITE_SKILLS_SH_PROXY=http://127.0.0.1:8787

VITE_SITE_URL=https://skill-dock.pages.dev

# Optional Logto account features. When these are empty, favorites stay local
# to the browser and no sign-in button is shown.
VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
VITE_LOGTO_APP_ID=your-spa-app-id
VITE_LOGTO_API_RESOURCE=https://catalog.example.com/api

# Catalog API base for account and favorites requests. Use an absolute URL
# when the site and catalog are on different origins.
VITE_CATALOG_API_URL=http://127.0.0.1:8080/api/v1

# Worker runtime settings live in wrangler.jsonc:
#   SKILLS_SH_ENABLED
#   SKILLS_SH_BASE_URL
