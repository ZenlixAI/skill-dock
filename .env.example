POSTGRES_DB=skill_registry
POSTGRES_USER=skill_registry
POSTGRES_PASSWORD=replace-with-a-secure-password

SKILL_REGISTRY_READER_TOKEN=replace-with-reader-token
SKILL_REGISTRY_AUTHORING_TOKEN=replace-with-authoring-token
SKILL_REGISTRY_PUBLISHER_TOKEN=replace-with-publisher-token

# Public URL returned in Catalog install targets.
REGISTRY_PUBLIC_URL=http://localhost:8080

# Set to false to remove every skills.sh surface from the API and Registry page.
SKILLS_SH_ENABLED=true
SKILL_REGISTRY_SKILLS_SH_URL=https://skills.sh

# Website local dev. The site is deployed to a Cloudflare Worker; its runtime
# settings are in apps/site/wrangler.jsonc. This proxy is only for Vite dev.
VITE_SKILLS_SH_PROXY=http://127.0.0.1:8787
