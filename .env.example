POSTGRES_DB=skill_registry
POSTGRES_USER=skill_registry
POSTGRES_PASSWORD=replace-with-a-secure-password

SKILL_REGISTRY_READER_TOKEN=replace-with-reader-token
SKILL_REGISTRY_AUTHORING_TOKEN=replace-with-authoring-token
SKILL_REGISTRY_PUBLISHER_TOKEN=replace-with-publisher-token

# Public URL returned in Catalog install targets.
REGISTRY_PUBLIC_URL=http://localhost:8080

# Set to false to remove every skills.sh surface from the API and Registry page.
SKILLS_SH_ENABLED=true
SKILL_REGISTRY_SKILLS_SH_URL=https://skills.sh

# User identity. Keep AUTH_MODE=legacy to preserve the shared-token deployment.
# hybrid accepts both legacy tokens and Logto JWTs; logto prefers Logto users
# and explicitly scoped service tokens.
SKILL_REGISTRY_AUTH_MODE=legacy
SKILL_REGISTRY_LOGTO_ENDPOINT=
SKILL_REGISTRY_LOGTO_ISSUER=
SKILL_REGISTRY_LOGTO_API_RESOURCE=
SKILL_REGISTRY_LOGTO_JWKS_URL=
# Exact browser origins allowed to call authenticated catalog routes.
SKILL_REGISTRY_CORS_ORIGINS=http://localhost:5173
# Optional SCIM 2.0 bearer token for /scim/v2 Users and Groups.
SKILL_REGISTRY_SCIM_TOKEN=

# Private artifact proxy. Upstream URL is server-side only and must not be
# reachable by clients. The catalog proxy enforces tenant + install permission.
SKILL_REGISTRY_PRIVATE_ARTIFACT_UPSTREAM_URL=
SKILL_REGISTRY_PRIVATE_ARTIFACT_READ_AUTHORIZATION=
SKILL_REGISTRY_PRIVATE_ARTIFACT_AUTH=catalog_proxy
SKILL_REGISTRY_ARTIFACT_PROXY_SIGNING_KEY=

# Website local dev. The site is deployed to a Cloudflare Worker; its runtime
# settings are in apps/site/wrangler.jsonc. This proxy is only for Vite dev.
VITE_SKILLS_SH_PROXY=http://127.0.0.1:8787
